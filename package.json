{
  "name": "react-example",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "compile:strongs": "node scripts/compile_strongs_study_db.cjs",
    "predev": "node scripts/compile_strongs_study_db.cjs",
    "prebuild": "node scripts/compile_strongs_study_db.cjs",
    "dev": "tsx local-dev-server.ts",
    "build": "node scripts/sync-branding-assets.js && node scripts/generate_win_icon.cjs && vite build && node scripts/purge_bundled_media.cjs && esbuild local-dev-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "bridge": "node server.js",
    "clean": "rm -rf dist",
    "generate-refs": "tsx scripts/generate_cross_references.ts",
    "lint": "tsc --noEmit",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "android:sync": "npm run build && node scripts/sync_android_launcher_icons.cjs && npx cap sync android",
    "android:build": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-navigation-bar": "^8.2.6",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^2.4.0",
    "@midvash/bible-data": "^0.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@types/selfsigned": "^2.0.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "selfsigned": "^5.5.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "@rollup/rollup-linux-x64-gnu": "^4.34.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reengineerpainter-bot/LogosBridge.git"
  },
  "build": {
    "appId": "com.logosbridge.app",
    "productName": "LogosBridge",
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "!**/dist-electron/**",
      "!dist-electron/**",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LogosBridge",
      "uninstallDisplayName": "LogosBridge",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
